{
  "name": "bitwebapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BITAcademia - Next.js app serving the React frontend and the Express API from a single server",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "nodemon --watch server --watch server.js server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint src pages --ext js,jsx --report-unused-disable-directives",
    "format": "prettier --write server scripts testing server.js",
    "format:check": "prettier --check server scripts testing server.js",
    "seed:pe": "node -r dotenv/config scripts/seedPeCourses.js"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@headlessui/react": "^1.7.18",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "classnames": "^2.5.1",
    "cloudinary": "^2.1.0",
    "cookie-parser": "^1.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.0.8",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "jwt-decode": "^4.0.0",
    "moment": "^2.30.1",
    "mongoose": "^8.2.3",
    "mongoose-aggregate-paginate-v2": "^1.0.7",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "next": "^16.3.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-big-calendar": "^1.18.0",
    "react-datepicker": "^6.8.0",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.0.1",
    "react-multi-carousel": "^2.8.5",
    "react-redux": "^9.1.1",
    "react-router-dom": "^6.23.0",
    "react-select": "^5.8.0",
    "react-slick": "^0.30.2",
    "react-spinners": "^0.13.8",
    "react-toastify": "^10.0.5",
    "recharts": "^2.12.1",
    "request-ip": "^3.3.0",
    "slick-carousel": "^1.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sweetalert2": "^11.6.13",
    "swiper": "^11.2.1",
    "tailwind-scrollbar": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1"
