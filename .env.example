# Server Configuration
# The Next.js frontend, the REST API (/api) and Socket.IO all run on this port.
PORT=3000
# Set to "true" to skip the node-cron jobs (e.g. when running several replicas)
DISABLE_CRON=false

# MongoDB
MONGODB_URI=mongodb://localhost:27017

# JWT Tokens
ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-change-in-production
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRY=10d

# CORS
# Frontend and API share one origin now, so this is only needed if the API is
# called from another domain.
CORS_ORIGIN=http://localhost:3000

# Email (for verification emails)
AUTH_EMAIL=your-email@gmail.com
AUTH_PASSWORD=your-app-password

# Admin user onboarding
# Base URL used for the login link in welcome emails (falls back to CORS_ORIGIN)
CLIENT_URL=http://localhost:3000
# How many onboarding welcome emails the provider allows per rolling window
ONBOARDING_MAIL_LIMIT=100
ONBOARDING_MAIL_WINDOW_HOURS=24

# Google Sign-In
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# Same value exposed to the browser. Leave unset to hide the "Sign in with Google" button.
# NEXT_PUBLIC_* variables are inlined at build time, so rebuild after changing them.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Optional: only needed if uploads / Socket.IO are served from a different origin
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOCKET_URL=
# Comma separated domains allowed to sign in. Empty disables the check.
GOOGLE_ALLOWED_DOMAINS=bitmesra.ac.in

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
